# Contact form delivery (src/app/api/contact/route.ts).
# Without both of these the form returns 503 and shows its WhatsApp / email /
# phone fallback instead of pretending the message was sent.

# https://resend.com -> API Keys
RESEND_API_KEY=

# A sender on a domain you have verified with Resend.
# e.g. "Blend Website <website@blendhairboutique.com>"
CONTACT_FROM=
