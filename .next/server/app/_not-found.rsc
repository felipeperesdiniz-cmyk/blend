s","description":"Manicures, pedicures, gel nails, and nail art by professional nail technicians in Plantation, FL."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Facials & Spa","url":"https://www.blendhairboutique.com/services#facials-spa","description":"Customized facials, hydrating treatments, and spa rituals for all skin types at Blend Hair Boutique."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Waxing & Brow Shaping","url":"https://www.blendhairboutique.com/services#waxing","description":"Full and partial body waxing, eyebrow shaping, and brow tinting services in Plantation, Florida."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Hair Extensions","url":"https://www.blendhairboutique.com/services#extensions","description":"Premium hair extensions including tape-in, sew-in, and clip-in methods. Consultation required."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Bridal & Event Beauty","url":"https://www.blendhairboutique.com/services#bridal-events","description":"Full bridal beauty packages including hair, nails, and skin services. Bridal trials, day-of styling, and group packages for bridal parties in South Florida."}}]},"aggregateRating":{"@type":"AggregateRating","ratingValue":"4.9","reviewCount":"1218","bestRating":"5","worstRating":"1"}}]}0:{"P":null,"b":"pfKt4aGtmRDzDGNvYnISd","p":"","c":["","_not-found"],"i":false,"f":[[["",{"children":["/_not-found",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",["$","$1","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/5ab16e37c3f8afa1.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}]],["$","html",null,{"lang":"en","children":[["$","head",null,{"children":[["$","link",null,{"rel":"preconnect","href":"https://fonts.googleapis.com"}],["$","link",null,{"rel":"preconnect","href":"https://fonts.gstatic.com","crossOrigin":""}],["$","link",null,{"href":"https://fonts.googleapis.com/css2?family=Co