10:Tb07,{"@context":"https://schema.org","@graph":[{"@type":"Service","name":"Hair Color Services in Plantation, FL","description":"Professional hair color services at Blend Hair Boutique in Plantation, Florida. All-over color, highlights, balayage, glossing, toning, and color correction.","provider":{"@id":"https://www.blendhairboutique.com/#business"},"areaServed":{"@type":"City","name":"Plantation, FL"},"url":"https://www.blendhairboutique.com/hair-color-plantation"},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What hair color services does Blend Hair Boutique offer?","acceptedAnswer":{"@type":"Answer","text":"Blend Hair Boutique offers a comprehensive range of hair color services including all-over color, highlights, lowlights, balayage, ombre, color glossing, toning, and professional color correction. Every service is customized to your hair type, skin tone, and lifestyle."}},{"@type":"Question","name":"How long does all-over hair color last?","acceptedAnswer":{"@type":"Answer","text":"All-over permanent hair color typically lasts 4–6 weeks before roots become noticeable and 8–12 weeks before a full reapplication is needed. Semi-permanent color tends to fade gradually over 4–8 washes, making it ideal for clients who want less commitment."}},{"@type":"Question","name":"What is a hair gloss treatment?","acceptedAnswer":{"@type":"Answer","text":"A hair gloss is a semi-permanent color treatment that adds shine, enhances your natural color, and neutralizes brassiness or unwanted tones. It's applied over your existing color or as a standalone treatment for luminous, healthy-looking hair. Results last approximately 4–6 weeks."}},{"@type":"Question","name":"Can Blend Hair Boutique fix a bad color job?","acceptedAnswer":{"@type":"Answer","text":"Yes — color correction is one of our specialties at Blend Hair Boutique. Whether you're dealing with brassiness, uneven color, damage from a previous treatment, or an unwanted tone, our colorists will assess your hair and create a safe, strategic correction plan."}},{"@type":"Question","name":"Do you offer color services for gray hair coverage?","acceptedAnswer":{"@type":"Answer","text":"Absolutely. Blend Hair Boutique offers seamless gray coverage in a range of formulas — full coverage, blended coverage, and gray blending techniques that soften the transition. Our colorists match your natural color precisely for a natural, polished result."}}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.blendhairboutique.com/"},{"@type":"ListItem","position":2,"name":"Services","item":"https://www.blendhairboutique.com/services"},{"@type":"ListItem","position":3,"name":"Hair Color in Plantation","item":"https://www.blendhairboutique.com/hair-color-plantation"}]}]}5:["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],["$","div",null,{"className":"page-enter","children":[["$","header",null,{"className":"page-hero page-hero--dark","children":["$","div",null,{"className":"container","style":{"position":"relative","zIndex":1},"children":[["$","p",null,{"style":{"fontSize":"0.82rem","letterSpacing":"0.2em","textTransform":"uppercase","color":"var(--gold)","fontWeight":500,"marginBottom":"1rem"},"children":"Plantation, Florida · Color Artistry"}],["$","h1",null,{"style":{"fontFamily":"var(--serif)","fontSize":"clamp(2.4rem, 5.5vw, 5.5rem)","fontWeight":300,"color":"var(--white)","letterSpacing":"-0.025em","lineHeight":1,"maxWidth":"16ch"},"children":["Hair ","$L11"," in Plantation, FL"]}],"$L12","$L13"]}]}],"$L14","$L15","$L16"]}]],null,"$L17"]}]
