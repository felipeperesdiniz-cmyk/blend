10:["$","script","6",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"@id\":\"https://www.blendhairboutique.com/services#extensions\",\"name\":\"Hair Extensions\",\"description\":\"Premium hair extensions applied for a seamless, natural look that blends beautifully with your own hair.\",\"provider\":{\"@id\":\"https://www.blendhairboutique.com/#business\"},\"areaServed\":{\"@type\":\"City\",\"name\":\"Plantation, FL\"},\"url\":\"https://www.blendhairboutique.com/services#extensions\"}"}}]
11:["$","script","7",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"@id\":\"https://www.blendhairboutique.com/services#bridal-events\",\"name\":\"Bridal & Event Beauty\",\"description\":\"Bridal packages, event styling, and beauty preparation for the days that matter most — hair, nails, and skin, all in one boutique.\",\"provider\":{\"@id\":\"https://www.blendhairboutique.com/#business\"},\"areaServed\":{\"@type\":\"City\",\"name\":\"Plantation, FL\"},\"url\":\"https://www.blendhairboutique.com/services#bridal-events\"}"}}]
1b:T11bf,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How do I book an appointment at Blend Hair Boutique?","acceptedAnswer":{"@type":"Answer","text":"You can book directly online through our Fresha booking system — available 24/7. Select your service, preferred stylist, and time. For bridal packages or consultations, contact us by phone at (754) 206-3501 or WhatsApp at (954) 544-6792."}},{"@type":"Question","name":"Where is Blend Hair Boutique located?","acceptedAnswer":{"@type":"Answer","text":"Blend Hair Boutique is located at 10035 Cleary Blvd, Plantation, FL 33324, in Broward County, South Florida. We are conveniently accessible from Plantation, Davie, Weston, Fort Lauderdale, Sunrise, Cooper City, and Pembroke Pines."}},{"@type":"Question","name":"What are your hours?","acceptedAnswer":{"@type":"Answer","text":"We are open Monday 10 AM–5 PM, Tuesday through Saturday 10 AM–7 PM, and closed on Sunday. Walk-ins are welcome, but appointments are recommended to secure your preferred time and stylist."}},{"@type":"Question","name":"What should I expect at my first visit?","acceptedAnswer":{"@type":"Answer","text":"Every new client begins with a thorough consultation. We ask about your hair history, current routine, lifestyle, and goals before recommending any service. This ensures we always deliver results tailored to you — never a generic outcome."}},{"@type":"Question","name":"How long does a balayage appointment take?","acceptedAnswer":{"@type":"Answer","text":"Balayage appointments typically range from 2.5 to 4 hours depending on your hair length, density, and the result you're aiming for. We'll give you a realistic time estimate during booking or consultation."}},{"@type":"Question","name":"Do you specialize in balayage and blonding?","acceptedAnswer":{"@type":"Answer","text":"Yes. Color and balayage is our most requested service. Our colorists specialize in custom balayage, highlights, blonding, and color correction — tailored to your hair texture, skin tone, and maintenance lifestyle. Blend Hair Boutique is one of Plantation's top-rated salons for color."}},{"@type":"Question","name":"Do you do Brazilian blowouts and keratin treatments?","acceptedAnswer":{"@type":"Answer","text":"Yes. Brazilian blowout and keratin smoothing treatments are a signature service at Blend — especially popular given Florida's humidity. Results typically last 3–5 months. We calibrate the formula to your hair type, from gentle smoothing to a full Brazilian blowout."}},{"@type":"Question","name":"Do you offer hair extensions?","acceptedAnswer":{"@type":"Answer","text":"Yes. We offer premium hair extensions including tape-in, sew-in, and clip-in methods. A consultation is required to assess your hair type and determine the best application method. Extension pricing varies by length and method."}},{"@type":"Question","name":"Do you offer bridal hair packages?","acceptedAnswer":{"@type":"Answer","text":"Yes. Blend offers full bridal beauty packages including hair, nails, and skin services. We provide bridal trials, day-of styling, and group packages for bridal parties throughout South Florida. We recommend booking bridal consultations well in advance."}},{"@type":"Question","name":"What languages does the Blend team speak?","acceptedAnswer":{"@type":"Answer","text":"The Blend Hair Boutique team is multilingual — we serve clients in English, Portuguese, and Spanish. Our Brazilian-trained specialists bring both technical expertise and genuine warmth to every appointment."}},{"@type":"Question","name":"Do you offer gift cards?","acceptedAnswer":{"@type":"Answer","text":"Yes — we offer gift cards in any amount, perfect for the people in your life who deserve a little luxury. They can be purchased online through our booking platform or in the boutique."}},{"@type":"Question","name":"What is your cancellation policy?","acceptedAnswer":{"@type":"Answer","text":"We ask for at least 24 hours' notice for cancellations or rescheduling. Late cancellations or no-shows may be subject to a fee. We appreciate your understanding — it helps us serve all clients well."}},{"@type":"Question","name":"Do you use Kérastase or professional hair care products?","acceptedAnswer":{"@type":"Answer","text":"We work with professional-grade color and care lines selected for performance and hair health — including products from premium professional ranges. We're always happy to recommend home-care products that complement your in-salon treatment."}}]}12:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1b"}}]
