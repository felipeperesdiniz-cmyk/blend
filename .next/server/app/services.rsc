5:["$","$1","c",{"children":[[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"@id\":\"https://www.blendhairboutique.com/services#color-balayage\",\"name\":\"Color & Balayage\",\"description\":\"From sun-kissed balayage to rich all-over color, our colorists craft custom formulas tailored to your hair texture, skin tone, and maintenance preferences.\",\"provider\":{\"@id\":\"https://www.blendhairboutique.com/#business\"},\"areaServed\":{\"@type\":\"City\",\"name\":\"Plantation, FL\"},\"url\":\"https://www.blendhairboutique.com/services#color-balayage\"}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"@id\":\"https://www.blendhairboutique.com/services#cuts-styling\",\"name\":\"Haircuts & Styling\",\"description\":\"Precision cuts, lived-in layers, and blowout styling that flatter your face shape and require minimal daily effort.\",\"provider\":{\"@id\":\"https://www.blendhairboutique.com/#business\"},\"areaServed\":{\"@type\":\"City\",\"name\":\"Plantation, FL\"},\"url\":\"https://www.blendhairboutique.com/services#cuts-styling\"}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"@id\":\"https://www.blendhairboutique.com/services#smoothing-keratin\",\"name\":\"Brazilian Blowout & Keratin\",\"description\":\"Our Brazilian-inspired smoothing treatments eliminate frizz, reduce styling time, and leave your hair brilliantly smooth, soft, and healthy-looking.\",\"provider\":{\"@id\":\"https://www.blendhairboutique.com/#business\"},\"areaServed\":{\"@type\":\"City\",\"name\":\"Plantation, FL\"},\"url\":\"https://www.blendhairboutique.com/services#smoothing-keratin\"}"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"@id\":\"https://www.blendhairboutique.com/services#nails\",\"name\":\"Nail Services\",\"description\":\"Manicures, pedicures, gel, and nail art. Our nail technicians deliver polished, precise results whether you prefer timeless classics or statement designs.\",\"provider\":{\"@id\":\"https://www.blendhairboutique.com/#business\"},\"areaServed\":{\"@type\":\"City\",\"name\":\"Plantation, FL\"},\"url\":\"https://www.blendhairboutique.com/services#nails\"}"}}],["$","script","4",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"@id\":\"https://www.blendhairboutique.com/services#facials-spa\",\"name\":\"Facials & Spa\",\"description\":\"Customized facials, hydrating treatments, and spa rituals designed to brighten, balance, and restore your skin's natural glow.\",\"provider\":{\"@id\":\"https://www.blendhairboutique.com/#business\"},\"areaServed\":{\"@type\":\"City\",\"name\":\"Plantation, FL\"},\"url\":\"https://www.blendhairboutique.com/services#facials-spa\"}"}}],["$","script","5",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"@id\":\"https://www.blendhairboutique.com/services#waxing\",\"name\":\"Waxing & Brow Shaping\",\"description\":\"Full and partial body waxing, eyebrow shaping, and brow tinting performed with precision and care.\",\"provider\":{\"@id\":\"https://www.blendhairboutique.com/#business\"},\"areaServed\":{\"@type\":\"City\",\"name\":\"Plantation, FL\"},\"url\":\"https://www.blendhairboutique.com/services#waxing\"}"}}],"$L10","$L11"],"$L12","$L13","$L14"],null,"$L15"]}]
