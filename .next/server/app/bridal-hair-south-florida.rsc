10:Tb76,{"@context":"https://schema.org","@graph":[{"@type":"Service","name":"Bridal Hair Salon in South Florida","description":"Luxury bridal hair and beauty packages in South Florida at Blend Hair Boutique, Plantation, FL. Bridal trials, day-of hair styling, and group packages for wedding parties.","provider":{"@id":"https://www.blendhairboutique.com/#business"},"areaServed":[{"@type":"City","name":"Plantation, FL"},{"@type":"AdministrativeArea","name":"Broward County, FL"},{"@type":"AdministrativeArea","name":"South Florida"}],"url":"https://www.blendhairboutique.com/bridal-hair-south-florida"},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Does Blend Hair Boutique offer bridal hair consultations?","acceptedAnswer":{"@type":"Answer","text":"Yes — a bridal trial consultation is a key part of our bridal process. During the trial, we finalize your wedding day look, review hair and makeup options, and ensure you feel completely comfortable with the result before your big day. We strongly recommend booking the trial well in advance."}},{"@type":"Question","name":"How far in advance should I book bridal hair services?","acceptedAnswer":{"@type":"Answer","text":"We recommend booking bridal consultations at least 3–6 months before your wedding date, especially for peak wedding season (October–May in South Florida). Popular dates fill quickly — the earlier you book, the better."}},{"@type":"Question","name":"Does Blend Hair Boutique offer bridal party packages?","acceptedAnswer":{"@type":"Answer","text":"Yes — we offer coordinated group bridal packages for the entire wedding party, including hair, nails, and facial treatments. We can accommodate multiple clients on the wedding day with a pre-planned timeline to ensure everyone is ready on schedule."}},{"@type":"Question","name":"Do you offer on-location bridal services?","acceptedAnswer":{"@type":"Answer","text":"On-location services are available for select dates depending on stylist availability and travel logistics. Please contact us directly at (754) 206-3501 or via WhatsApp at (954) 544-6792 to discuss on-location options for your wedding."}},{"@type":"Question","name":"What does a bridal package include?","acceptedAnswer":{"@type":"Answer","text":"Bridal packages at Blend Hair Boutique can include hair styling (updo, waves, or blowout), nail services, and facial treatments. We create a personalized package based on your timeline, number of guests, and beauty goals. Each package starts with a bridal consultation to finalize all details."}}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.blendhairboutique.com/"},{"@type":"ListItem","position":2,"name":"Services","item":"https://www.blendhairboutique.com/services"},{"@type":"ListItem","position":3,"name":"Bridal Hair South Florida","item":"https://www.blendhairboutique.com/bridal-hair-south-florida"}]}]}5:["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}],["$","div",null,{"className":"page-enter","children":[["$","header",null,{"className":"page-hero page-hero--dark","children":["$","div",null,{"className":"container","style":{"position":"relative","zIndex":1},"children":[["$","p",null,{"style":{"fontSize":"0.82rem","letterSpacing":"0.2em","textTransform":"uppercase","color":"var(--gold)","fontWeight":500,"marginBottom":"1rem"},"children":"South Florida · Bridal Specialists"}],"$L11","$L12","$L13"]}]}],"$L14","$L15","$L16","$L17"]}]],null,"$L18"]}]
